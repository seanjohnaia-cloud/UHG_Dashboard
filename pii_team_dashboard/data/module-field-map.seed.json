{
  "schema": "pii-team-dashboard.module-field-map.seed.v0",
  "standing": {
    "status": "implementation_seed",
    "authority": "non_authoritative",
    "admissibility": "initiating",
    "verification": "unverified"
  },
  "principle": "The module-field map is the operating contract between stable module lenses and canonical project fields. Modules read fields, surface field standing, propose downstream changes, validate scoped use, or route gaps; they do not create independent truth stores.",
  "global_rules": {
    "origin_locked_groups": ["pac_layer_0_origin"],
    "origin_locked_behavior": "Origin fields may be read, cited, flagged, validated for scoped use, or superseded downstream with lineage, but not silently overwritten by module interaction.",
    "validation_behavior": "Validation fields may be confirmed for scoped operational use; validation does not rewrite origin evidence.",
    "transformation_behavior": "Transformation fields are downstream outputs from origin/validation data and must cite inputs.",
    "overlay_behavior": "Generic LCD-W/LCW and UHG LCD/LCW fields may add requirements for a project/client context without redefining PAC core.",
    "metadata_behavior": "Truth state, source reference, scope of use, blocking effect, follow-up, authority requirement, and route state travel with values.",
    "concurrence_behavior": "Current operational truth/state-tier updates require human concurrence before propagation into governed ledger-like standing. Seed files only model the rule; they do not enact approval."
  },
  "permission_values": ["read", "propose", "validate", "route", "archive", "derive"],
  "module_maps": [
    {
      "module_id": "project_origin",
      "role": "PAC origin/intake lens",
      "reads": ["proposal_date", "client_entity", "client_contact", "client_address", "project_name", "project_type", "market_sector", "project_location", "project_address", "project_description", "estimated_gsf", "estimated_construction_cost", "scope_clarity_status", "basic_services", "additional_services", "programming", "record_drawings", "professional_fee", "fee_breakdown_by_phase", "reimbursable_expenses", "billing_schedule", "project_schedule_by_phase", "schedule_confidence_status", "form_of_agreement", "insurance_requirements", "signature_block", "acceptance_status", "authorization_confirmation_status", "truth_state", "source_ref", "extraction_ref"],
      "proposes": ["validation_required_fields", "missing_fields", "gap_records"],
      "validates": ["client_contact", "client_address", "scope_clarity_status", "authorization_confirmation_status"],
      "routes": ["validation_required_fields", "missing_fields", "gap_records"],
      "archives": ["archived_source_records"],
      "derives": [],
      "cannot_overwrite": ["proposal_date", "client_entity", "project_name", "project_type", "market_sector", "project_location", "project_address", "project_description", "estimated_gsf", "estimated_construction_cost", "basic_services", "additional_services", "programming", "record_drawings", "professional_fee", "fee_breakdown_by_phase", "project_schedule_by_phase", "form_of_agreement", "signature_block", "acceptance_status"],
      "requires_concurrence_for": ["validation_required_fields", "missing_fields", "gap_records"],
      "notes": "Project Origin displays PAC Layer 0. It may expose validation/missing conditions but must preserve original PAC/source statement."
    },
    {
      "module_id": "activation_gates",
      "role": "Section A blocking-by-default activation evaluator",
      "reads": ["acceptance_status", "authorization_confirmation", "authorization_confirmation_status", "ntp_or_equivalent_authorization", "accountable_project_owner", "project_number", "activation_identifier", "project_name", "project_location", "project_description", "scope_clarity_status", "scope_baseline_sufficiency", "professional_fee", "fee_breakdown_by_phase", "fee_basis_alignment", "project_schedule_by_phase", "schedule_confidence_status", "schedule_baseline_acknowledgment", "form_of_agreement", "contract_path_identified", "insurance_requirements", "risk_requirement_reviewed", "additional_services", "programming", "record_drawings", "consultant_trigger_routing_status", "billing_schedule", "billing_path_viability", "all_gate_conditions_evaluated", "approval_path_governance_satisfied", "activation_override_record", "override_records", "truth_state", "source_ref", "scope_of_use", "blocking_effect", "authority_requirement"],
      "proposes": ["activation_gate_status", "activation_override_record", "override_records", "missing_fields", "validation_required_fields", "gap_records", "setup_blockers", "governance_route_state", "follow_up_required"],
      "validates": ["authorization_confirmation", "ntp_or_equivalent_authorization", "accountable_project_owner", "scope_baseline_sufficiency", "fee_basis_alignment", "schedule_baseline_acknowledgment", "contract_path_identified", "risk_requirement_reviewed", "consultant_trigger_routing_status", "billing_path_viability", "all_gate_conditions_evaluated", "approval_path_governance_satisfied"],
      "routes": ["missing_fields", "validation_required_fields", "gap_records", "override_records", "setup_blockers", "governance_route_state"],
      "archives": ["archived_source_records"],
      "derives": ["activation_gate_status"],
      "cannot_overwrite": ["acceptance_status", "project_description", "professional_fee", "fee_breakdown_by_phase", "project_schedule_by_phase", "form_of_agreement"],
      "requires_concurrence_for": ["activation_gate_status", "activation_override_record", "override_records", "gap_records", "setup_blockers", "governance_route_state"],
      "notes": "Activation evaluates permission/readiness and produces downstream status; it does not rewrite PAC. Overrides require accountable decision lineage."
    },
    {
      "module_id": "scope",
      "role": "Scope/project-definition operational lens",
      "reads": ["project_description", "estimated_gsf", "project_type", "market_sector", "project_address", "scope_clarity_status", "basic_services", "additional_services", "programming", "record_drawings", "scope_baseline_sufficiency", "lcd_required_fields", "project_analysis_fields", "uhg_required_fields", "service_order_scope", "standards", "design_inputs", "specialty_scope_signals", "truth_state", "source_ref", "scope_of_use"],
      "proposes": ["scope_baseline_sufficiency", "specialty_scope_signals", "missing_fields", "validation_required_fields", "gap_records", "conflicts", "conflict_records", "follow_up_required"],
      "validates": ["scope_clarity_status", "scope_baseline_sufficiency", "service_order_scope"],
      "routes": ["specialty_scope_signals", "missing_fields", "validation_required_fields", "conflicts", "gap_records", "conflict_records"],
      "archives": ["archived_source_records"],
      "derives": ["specialty_scope_signals"],
      "cannot_overwrite": ["project_description", "estimated_gsf", "basic_services", "additional_services", "programming", "record_drawings"],
      "requires_concurrence_for": ["scope_baseline_sufficiency", "specialty_scope_signals", "gap_records", "conflict_records"],
      "notes": "Scope begins from PAC origin and overlays; later clarifications must be downstream with lineage."
    },
    {
      "module_id": "contracts",
      "role": "Contract/authorization lens",
      "reads": ["client_address", "project_description", "basic_services", "additional_services", "professional_fee", "fee_breakdown_by_phase", "billing_schedule", "project_schedule_by_phase", "schedule_confidence_status", "form_of_agreement", "insurance_requirements", "signature_block", "acceptance_status", "authorization_confirmation", "authorization_confirmation_status", "ntp_or_equivalent_authorization", "contract_path_identified", "risk_requirement_reviewed", "fee_basis_alignment", "contractual_dates", "workflow_rules", "uhg_required_fields", "service_order_terms", "service_order_scope", "schedule_e_f_logic", "truth_state", "source_ref", "scope_of_use", "authority_requirement"],
      "proposes": ["contract_path_identified", "risk_requirement_reviewed", "contractual_dates", "service_order_terms", "service_order_scope", "missing_fields", "validation_required_fields", "conflicts", "conflict_records", "governance_route_state", "follow_up_required"],
      "validates": ["authorization_confirmation", "contract_path_identified", "risk_requirement_reviewed", "fee_basis_alignment", "contractual_dates", "service_order_terms", "service_order_scope"],
      "routes": ["missing_fields", "validation_required_fields", "conflicts", "conflict_records", "governance_route_state"],
      "archives": ["archived_source_records"],
      "derives": [],
      "cannot_overwrite": ["form_of_agreement", "acceptance_status", "professional_fee", "fee_breakdown_by_phase", "project_schedule_by_phase", "project_description", "basic_services", "additional_services"],
      "requires_concurrence_for": ["contract_path_identified", "risk_requirement_reviewed", "contractual_dates", "service_order_terms", "service_order_scope", "conflict_records", "governance_route_state"],
      "notes": "Contracts may validate alignment and expose overlay requirements; it does not turn UHG overlay fields into PAC core."
    },
    {
      "module_id": "budget",
      "role": "Financial transformation and production-budget lens",
      "reads": ["estimated_construction_cost", "professional_fee", "fee_breakdown_by_phase", "reimbursable_expenses", "billing_schedule", "project_schedule_by_phase", "milestones", "fee_basis_alignment", "billing_path_viability", "financial_model", "truth_state", "source_ref", "scope_of_use", "blocking_effect"],
      "proposes": ["financial_model", "fee_basis_alignment", "billing_path_viability", "missing_fields", "validation_required_fields", "setup_blockers", "gap_records", "follow_up_required"],
      "validates": ["fee_basis_alignment", "billing_path_viability", "financial_model"],
      "routes": ["missing_fields", "validation_required_fields", "setup_blockers", "gap_records"],
      "archives": [],
      "derives": ["financial_model"],
      "cannot_overwrite": ["estimated_construction_cost", "professional_fee", "fee_breakdown_by_phase", "billing_schedule", "project_schedule_by_phase"],
      "requires_concurrence_for": ["financial_model", "fee_basis_alignment", "billing_path_viability", "setup_blockers"],
      "notes": "Budget transforms PAC fee/cost/schedule data into operational financial model without rewriting origin fee facts."
    },
    {
      "module_id": "compensation",
      "role": "Fee/compensation lens",
      "reads": ["estimated_construction_cost", "professional_fee", "fee_breakdown_by_phase", "reimbursable_expenses", "additional_services", "billing_schedule", "fee_basis_alignment", "financial_model", "service_order_terms", "schedule_e_f_logic", "truth_state", "source_ref", "scope_of_use"],
      "proposes": ["fee_basis_alignment", "financial_model", "missing_fields", "validation_required_fields", "gap_records", "follow_up_required"],
      "validates": ["fee_basis_alignment", "professional_fee", "fee_breakdown_by_phase", "reimbursable_expenses"],
      "routes": ["missing_fields", "validation_required_fields", "gap_records"],
      "archives": [],
      "derives": ["financial_model"],
      "cannot_overwrite": ["professional_fee", "fee_breakdown_by_phase", "reimbursable_expenses", "additional_services", "billing_schedule"],
      "requires_concurrence_for": ["fee_basis_alignment", "financial_model", "gap_records"],
      "notes": "Compensation distinguishes proposal-origin fee, contract-authorized fee, Service Order-derived fee, and unresolved fee assumptions."
    },
    {
      "module_id": "schedule",
      "role": "Schedule/milestone lens",
      "reads": ["project_schedule_by_phase", "schedule_confidence_status", "schedule_baseline_acknowledgment", "milestones", "owner_dependencies", "contractual_dates", "fee_breakdown_by_phase", "billing_schedule", "operational_alignment", "design_inputs", "truth_state", "source_ref", "scope_of_use"],
      "proposes": ["schedule_baseline_acknowledgment", "milestones", "owner_dependencies", "contractual_dates", "operational_alignment", "missing_fields", "validation_required_fields", "gap_records", "follow_up_required"],
      "validates": ["schedule_confidence_status", "schedule_baseline_acknowledgment", "contractual_dates"],
      "routes": ["missing_fields", "validation_required_fields", "gap_records"],
      "archives": [],
      "derives": ["milestones", "operational_alignment"],
      "cannot_overwrite": ["project_schedule_by_phase", "schedule_confidence_status", "fee_breakdown_by_phase", "billing_schedule"],
      "requires_concurrence_for": ["schedule_baseline_acknowledgment", "milestones", "owner_dependencies", "contractual_dates", "operational_alignment"],
      "notes": "Schedule can derive working milestones and alignment views while keeping PAC schedule and confidence visible."
    },
    {
      "module_id": "team_responsibility",
      "role": "Section B responsibility lens",
      "reads": ["client_contact", "accountable_project_owner", "pic", "pm", "pa", "consultant_roles", "owner_contacts", "responsibility_assignments", "proposal_requests", "consultant_trigger_routing_status", "operational_alignment", "truth_state", "source_ref", "follow_up_required"],
      "proposes": ["accountable_project_owner", "pic", "pm", "pa", "owner_contacts", "responsibility_assignments", "consultant_trigger_routing_status", "operational_alignment", "missing_fields", "gap_records", "follow_up_required"],
      "validates": ["accountable_project_owner", "pic", "pm", "pa", "owner_contacts", "responsibility_assignments"],
      "routes": ["missing_fields", "gap_records", "consultant_trigger_routing_status"],
      "archives": [],
      "derives": ["responsibility_assignments"],
      "cannot_overwrite": ["client_contact", "additional_services", "programming", "record_drawings"],
      "requires_concurrence_for": ["accountable_project_owner", "pic", "pm", "pa", "responsibility_assignments", "consultant_trigger_routing_status"],
      "notes": "Team + Responsibility fills downstream operational assignments; it may satisfy activation ownership but does not change PAC contact/source facts."
    },
    {
      "module_id": "consultants",
      "role": "Consultant/partner coordination lens",
      "reads": ["additional_services", "programming", "record_drawings", "specialty_scope_signals", "consultant_roles", "owner_contacts", "responsibility_assignments", "proposal_requests", "consultant_trigger_routing_status", "truth_state", "source_ref", "follow_up_required"],
      "proposes": ["specialty_scope_signals", "consultant_roles", "proposal_requests", "consultant_trigger_routing_status", "missing_fields", "gap_records", "follow_up_required"],
      "validates": ["consultant_roles", "proposal_requests", "consultant_trigger_routing_status"],
      "routes": ["specialty_scope_signals", "missing_fields", "gap_records"],
      "archives": [],
      "derives": ["specialty_scope_signals"],
      "cannot_overwrite": ["additional_services", "programming", "record_drawings"],
      "requires_concurrence_for": ["consultant_roles", "proposal_requests", "consultant_trigger_routing_status", "specialty_scope_signals"],
      "notes": "Consultants receives PAC scope/service triggers and maps them into Section B roles/proposals."
    },
    {
      "module_id": "lcd_w_analysis",
      "role": "Generic LCD-W / UHG LCD/LCW overlay analysis lens",
      "reads": ["project_type", "estimated_gsf", "programming", "lcd_required_fields", "project_analysis_fields", "workflow_rules", "uhg_required_fields", "service_order_terms", "service_order_scope", "schedule_e_f_logic", "truth_state", "source_ref", "extraction_ref", "scope_of_use", "blocking_effect"],
      "proposes": ["lcd_required_fields", "project_analysis_fields", "workflow_rules", "uhg_required_fields", "service_order_terms", "service_order_scope", "schedule_e_f_logic", "missing_fields", "validation_required_fields", "gap_records", "follow_up_required"],
      "validates": ["lcd_required_fields", "project_analysis_fields", "uhg_required_fields", "service_order_terms", "service_order_scope"],
      "routes": ["missing_fields", "validation_required_fields", "gap_records", "governance_route_state"],
      "archives": ["archived_source_records"],
      "derives": ["project_analysis_fields"],
      "cannot_overwrite": ["project_type", "estimated_gsf", "programming", "project_description", "professional_fee", "fee_breakdown_by_phase"],
      "requires_concurrence_for": ["lcd_required_fields", "project_analysis_fields", "workflow_rules", "uhg_required_fields", "service_order_terms", "service_order_scope", "schedule_e_f_logic", "governance_route_state"],
      "notes": "LCD-W Analysis attaches generic or UHG overlay requirements to the shared field spine; it does not redefine PAC core."
    },
    {
      "module_id": "system_setup",
      "role": "LCW Section E system setup lens",
      "reads": ["project_address", "authorization_confirmation", "project_number", "activation_identifier", "setup_blockers", "system_setup", "platforms", "folder_structure", "model_environment", "standards", "file_locations", "record_drawings", "operational_alignment", "truth_state", "source_ref", "blocking_effect", "follow_up_required"],
      "proposes": ["system_setup", "platforms", "folder_structure", "model_environment", "standards", "file_locations", "setup_blockers", "missing_fields", "gap_records", "follow_up_required"],
      "validates": ["system_setup", "platforms", "folder_structure", "model_environment", "file_locations"],
      "routes": ["setup_blockers", "missing_fields", "gap_records"],
      "archives": [],
      "derives": ["system_setup", "setup_blockers"],
      "cannot_overwrite": ["project_address", "authorization_confirmation", "project_number", "activation_identifier", "record_drawings"],
      "requires_concurrence_for": ["system_setup", "platforms", "folder_structure", "model_environment", "standards", "file_locations", "setup_blockers"],
      "notes": "System Setup waits on activation identifiers/authorization where required and records setup blockers instead of hiding them."
    },
    {
      "module_id": "risk_gaps",
      "role": "Risk, gap, conflict, archive, and governance-routing lens",
      "reads": ["scope_clarity_status", "schedule_confidence_status", "insurance_requirements", "project_number", "activation_gate_status", "activation_override_record", "override_records", "owner_dependencies", "design_inputs", "truth_state", "source_ref", "extraction_ref", "scope_of_use", "blocking_effect", "follow_up_required", "authority_requirement", "governance_route_state", "missing_fields", "validation_required_fields", "conflicts", "gap_records", "conflict_records", "archived_source_records", "setup_blockers", "specialty_scope_signals"],
      "proposes": ["missing_fields", "validation_required_fields", "conflicts", "gap_records", "conflict_records", "archived_source_records", "setup_blockers", "follow_up_required", "authority_requirement", "governance_route_state"],
      "validates": [],
      "routes": ["missing_fields", "validation_required_fields", "conflicts", "gap_records", "conflict_records", "override_records", "setup_blockers", "specialty_scope_signals", "governance_route_state"],
      "archives": ["archived_source_records"],
      "derives": ["missing_fields", "validation_required_fields", "conflicts"],
      "cannot_overwrite": ["proposal_date", "client_entity", "project_name", "project_description", "estimated_construction_cost", "professional_fee", "fee_breakdown_by_phase", "project_schedule_by_phase", "form_of_agreement", "acceptance_status", "authorization_confirmation", "project_number"],
      "requires_concurrence_for": ["gap_records", "conflict_records", "override_records", "setup_blockers", "authority_requirement", "governance_route_state"],
      "notes": "Risk/Gaps/Archive is routing-first. It collects visible unresolved state and archive needs but does not mutate source fields directly."
    }
  ]
}
